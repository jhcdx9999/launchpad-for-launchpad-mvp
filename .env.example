# Local server
HOST=127.0.0.1
PORT=4002

# Public deployment URL shown by docs/scripts. For your server, set this to https://jkswebtest.xyz
PUBLIC_APP_URL=https://launch.jkswebtest.xyz

# Launchpad tenant URL display. For PRD-style subdomains on your domain, use jkswebtest.xyz.
# The frontend will render examples such as ai.jkswebtest.xyz.
PUBLIC_BASE_DOMAIN=launch.jkswebtest.xyz

# Local JSON store path
DATA_FILE=data/launchpad-db.json
STATS_FILE=data/launchpad-stats.json

# Admin credentials for /admin. Replace password and session secret before public deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret

# Demo wallets used by the hackathon MVP wallet simulation and seeded data
DEMO_OWNER_WALLET=0x1111111111111111111111111111111111111111
DEMO_CREATOR_WALLET=0x2222222222222222222222222222222222222222
